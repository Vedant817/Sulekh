# Sulekh — environment variables
# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.
# The typed loader in src/lib/env.ts fails fast with a named error if a required
# variable is missing or malformed.

# --- Supabase (Postgres + pgvector + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase → Project Settings → Database).
# Used by db:migrate + seed scripts and by the runtime health probe
# (GET /api/health) for a connection-level DB/corpus check. Application data
# access still goes through the Supabase JS client (RLS-enforced). SSL required.
DATABASE_URL=

# --- Groq (LLM provider — OpenAI-compatible; hosts Llama / GPT-OSS / Kimi etc.) ---
GROQ_API_KEY=
# Model IDs are read from env and never hardcoded in source. Must be tool-use
# (function-calling) capable. Drafting = narrative sections; Reasoning =
# Basis for Issue Price / Risk Factors / MD&A / Financials. See console.groq.com/docs/models.
MODEL_DRAFTING=openai/gpt-oss-20b
MODEL_REASONING=openai/gpt-oss-120b

# --- Embeddings (configurable provider) ---
# Default: local ONNX inference through Transformers.js — no API quota or text
# egress. The first run downloads and caches the pinned MIT-licensed model.
# Gemini fallback: set provider=gemini, provide the API key, and either set
# model=gemini-embedding-2 or leave the model blank for that provider default.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=Xenova/bge-base-en-v1.5
EMBEDDINGS_MODEL_REVISION=4d6cd88e18e51a5e020c2c305726d76ada9c03cf
# Optional override. Vercel automatically uses writable /tmp; local runs use
# .cache/transformers. Set this for a persistent cache on another host.
EMBEDDINGS_CACHE_DIR=
EMBEDDINGS_DIM=768

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Optional credentialed external data providers ---
# Leave blank to fall through to the real default adapter (document upload + parse).
# A blank provider never fabricates data — missing values become gap flags.
MCA_API_KEY=
GST_API_KEY=
